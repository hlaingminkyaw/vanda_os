<mxfile host="app.diagrams.net">
<diagram name="E-Commerce Swimlane Process Flow">
<mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>

<mxCell id="lane1" value="Customer (Mobile App)" style="swimlane;html=1;horizontal=0;rounded=0;" vertex="1" parent="1">
<mxGeometry x="20" y="40" width="250" height="900" as="geometry"/>
</mxCell>

<mxCell id="lane2" value="Backend System" style="swimlane;html=1;horizontal=0;rounded=0;" vertex="1" parent="1">
<mxGeometry x="270" y="40" width="300" height="900" as="geometry"/>
</mxCell>

<mxCell id="lane3" value="Admin / Shop Staff" style="swimlane;html=1;horizontal=0;rounded=0;" vertex="1" parent="1">
<mxGeometry x="570" y="40" width="300" height="900" as="geometry"/>
</mxCell>

<mxCell id="lane4" value="Warehouse / Inventory" style="swimlane;html=1;horizontal=0;rounded=0;" vertex="1" parent="1">
<mxGeometry x="870" y="40" width="300" height="900" as="geometry"/>
</mxCell>

<mxCell id="lane5" value="Delivery Service" style="swimlane;html=1;horizontal=0;rounded=0;" vertex="1" parent="1">
<mxGeometry x="1170" y="40" width="300" height="900" as="geometry"/>
</mxCell>


<mxCell id="c1" value="Browse Products&#xa;Search Product&#xa;View Details" style="rounded=1;html=1;" vertex="1" parent="lane1">
<mxGeometry x="40" y="80" width="170" height="80" as="geometry"/>
</mxCell>

<mxCell id="c2" value="Add To Cart&#xa;Checkout&#xa;Submit Order" style="rounded=1;html=1;" vertex="1" parent="lane1">
<mxGeometry x="40" y="230" width="170" height="80" as="geometry"/>
</mxCell>

<mxCell id="b1" value="Receive Order API&#xa;Validate User&#xa;Check Stock" style="rounded=1;html=1;" vertex="1" parent="lane2">
<mxGeometry x="50" y="230" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="b2" value="Create Order Record&#xa;Reserve Stock&#xa;Send Notification" style="rounded=1;html=1;" vertex="1" parent="lane2">
<mxGeometry x="50" y="390" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="a1" value="Receive New Order&#xa;Review Order&#xa;Confirm Order" style="rounded=1;html=1;" vertex="1" parent="lane3">
<mxGeometry x="50" y="390" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="w1" value="Pick Product&#xa;Pack Product&#xa;Update Stock" style="rounded=1;html=1;" vertex="1" parent="lane4">
<mxGeometry x="50" y="520" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="d1" value="Admin Contacts Delivery Service&#xa;Delivery Service Gives ETA Date" style="rounded=1;html=1;" vertex="1" parent="lane5">
<mxGeometry x="40" y="650" width="210" height="100" as="geometry"/>
</mxCell>

<mxCell id="a2" value="Enter Delivery Company Info&#xa;Enter Estimated Arrival Date" style="rounded=1;html=1;" vertex="1" parent="lane3">
<mxGeometry x="50" y="650" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="c3" value="Customer Views ETA Date Only&#xa;Wait For Delivery" style="rounded=1;html=1;" vertex="1" parent="lane1">
<mxGeometry x="40" y="650" width="170" height="90" as="geometry"/>
</mxCell>

<mxCell id="finish" value="Admin Inquires Delivery Service&#xa;Confirm Arrival&#xa;Close Order" style="rounded=1;html=1;" vertex="1" parent="lane3">
<mxGeometry x="50" y="820" width="190" height="90" as="geometry"/>
</mxCell>

<mxCell id="e1" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" edge="1" parent="1" source="c2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" edge="1" parent="1" source="b2" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" edge="1" parent="1" source="a1" target="w1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" edge="1" parent="1" source="w1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" edge="1" parent="1" source="d1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" edge="1" parent="1" source="a2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" edge="1" parent="1" source="c3" target="finish"><mxGeometry relative="1" as="geometry"/></mxCell>

</root>
</mxGraphModel>
</diagram>
</mxfile>